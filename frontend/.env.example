# Copy this file to frontend/.env.local and adjust if needed.
# .env.local is gitignored. Never commit real values.

# Base URL of the API.
#
# Leave this EMPTY in development: the Vite proxy forwards /api to the backend,
# which keeps the browser on one origin so the session cookie is attached
# without SameSite=None or HTTPS.
#
# In production set it to the deployed API origin, e.g.
#   VITE_API_BASE_URL="https://roundready-api.onrender.com"
VITE_API_BASE_URL=""

# Where the dev proxy forwards /api. Defaults to http://localhost:5001.
# VITE_API_PROXY="http://localhost:5001"
