# Copy this file to backend/.env and fill in the values.
# .env is gitignored. Never commit real values.

# MongoDB Atlas connection string (the M0 free tier is sufficient).
# Atlas -> Database -> Connect -> Drivers.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name. Optional; defaults to "roundready".
MONGODB_DB="roundready"

# Random 32-byte secret used to sign the session cookie.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Port the API listens on. The Vite dev proxy expects 5001.
PORT="5001"

# Origin allowed to send credentialed requests. In development the Vite proxy
# makes the app same-origin, so this only matters once the two are deployed
# separately — and then it must be the exact frontend origin, not "*", because
# CORS forbids a wildcard with credentials.
FRONTEND_URL="http://localhost:5173"

# "development" or "production". Decides the session cookie's SameSite/Secure
# pair: lax+insecure behind the dev proxy, none+secure across origins in
# production (which therefore requires HTTPS on both deployments).
NODE_ENV="development"

# Optional: override the seeded demo account (npm run seed).
# These are demo data, not secrets.
# SEED_EMAIL="demo@roundready.app"
# SEED_PASSWORD="placement2026"

# The code that grants the CDC officer role at registration.
#
# Optional, and it fails CLOSED: with no code set, nobody can register as an
# officer at all. Whoever holds this can publish drives and change eligibility
# criteria for an entire batch, so treat it like a password — at least 12
# characters (the server refuses to start with a shorter one), and rotate it
# when someone leaves the role.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CDC_OFFICER_CODE=""

# Optional: override the seeded CDC officer account (npm run seed).
# Demo data, not secrets.
# SEED_OFFICER_EMAIL="cdc@roundready.app"
# SEED_OFFICER_PASSWORD="placement2026"
