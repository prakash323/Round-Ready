{
  // Typechecking only. The build config (tsconfig.json) excludes `tests/`,
  // because the suite imports through the `@/` alias that `tsc` cannot rewrite
  // on emit — vitest resolves it instead. This config covers the same files
  // with `noEmit`, so `npm run typecheck` still sees the tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["server.ts", "src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
